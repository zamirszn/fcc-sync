#!/usr/bin/env bash
# fcc-sync — export/import free-claude-code configuration between devices.
#
#   fcc-sync export [file]    bundle ~/.fcc/.env + OAuth tokens (default ~/fcc-backup-<date>.tar.gz)
#   fcc-sync import <file>    restore a bundle: backup existing config, install fcc if missing, restart server
#   fcc-sync status           show server state, active model, configured providers
#
set -euo pipefail

FCC_DIR="${HOME}/.fcc"
ENV_FILE="${FCC_DIR}/.env"
AUTH_DIR="${FCC_DIR}/auth"
LOG_FILE="${FCC_DIR}/logs/server.log"
TMP_DIR=""

cleanup() { [[ -n "$TMP_DIR" ]] && rm -rf "$TMP_DIR"; return 0; }
trap cleanup EXIT

die() { echo "fcc-sync: $*" >&2; exit 1; }

# ---------------------------------------------------------------- helpers

fcc_port() {
    # Port comes from .env (PORT=...) with fcc's default of 8082.
    local port=8082
    if [[ -f "$ENV_FILE" ]]; then
        local found
        found=$(grep -E '^PORT=' "$ENV_FILE" | tail -1 | cut -d= -f2 || true)
        [[ -n "$found" ]] && port="$found"
    fi
    echo "$port"
}

fcc_host() {
    local host=127.0.0.1
    if [[ -f "$ENV_FILE" ]]; then
        local found
        found=$(grep -E '^HOST=' "$ENV_FILE" | tail -1 | cut -d= -f2 || true)
        [[ -n "$found" ]] && host="$found"
    fi
    echo "$host"
}

status_url() { echo "http://$(fcc_host):$(fcc_port)/admin/api/status"; }

server_up() { curl -sf --max-time 3 "$(status_url)" >/dev/null 2>&1; }

# Count configured providers from the admin status payload (everything not
# missing a key/config and not a disconnected connected-account).
provider_count() {
    curl -sf --max-time 5 "$(status_url)" 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
n = sum(1 for p in d.get("provider_status", [])
        if p.get("status") not in ("missing_key", "missing_config", "disconnected"))
print(n)' 2>/dev/null || echo "?"
}

fcc_version() {
    local v=""
    # uv tool installs keep dist-info in a predictable place.
    local dist
    dist=$(find "${HOME}/.local/share/uv/tools/free-claude-code" -maxdepth 4 \
           -name 'free_claude_code-*.dist-info' -type d 2>/dev/null | head -1)
    if [[ -n "$dist" ]]; then
        v=$(basename "$dist" | sed 's/^free_claude_code-//; s/\.dist-info$//')
    fi
    # Fallback: ask the running server's interpreter.
    if [[ -z "$v" ]] && command -v fcc-server >/dev/null 2>&1; then
        local py
        py=$(readlink -f "$(command -v fcc-server)")
        py="${py%/*}/python"
        [[ -x "$py" ]] && v=$("$py" -c 'import importlib.metadata; print(importlib.metadata.version("free-claude-code"))' 2>/dev/null || true)
    fi
    [[ -n "$v" ]] || v="unknown"
    echo "$v"
}

# Resolve the fcc-server executable, tolerating ~/.local/bin being off PATH.
find_fcc_server() {
    if command -v fcc-server >/dev/null 2>&1; then command -v fcc-server; return 0; fi
    [[ -x "${HOME}/.local/bin/fcc-server" ]] && { echo "${HOME}/.local/bin/fcc-server"; return 0; }
    return 1
}

find_uv() {
    if command -v uv >/dev/null 2>&1; then command -v uv; return 0; fi
    local cand
    for cand in "${HOME}/.local/bin/uv" "${HOME}/.cargo/bin/uv"; do
        [[ -x "$cand" ]] && { echo "$cand"; return 0; }
    done
    return 1
}

stop_server() {
    local pids
    pids=$(pgrep -f '[f]cc-server' || true)
    [[ -z "$pids" ]] && return 0
    # Only kill processes that really are fcc-server (pgrep -f can match this script).
    local p
    for p in $pids; do
        if tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q 'fcc-server'; then
            kill "$p" 2>/dev/null || true
        fi
    done
    # Wait up to 10s for the port to be released.
    local i
    for i in $(seq 1 20); do
        server_up || return 0
        sleep 0.5
    done
    echo "fcc-sync: warning: server still responding after stop attempt" >&2
}

start_server() {
    mkdir -p "$(dirname "$LOG_FILE")"
    local server_bin
    server_bin=$(find_fcc_server) || die "fcc-server not found"
    nohup "$server_bin" >>"$LOG_FILE" 2>&1 &
    disown 2>/dev/null || true
    # Wait up to 30s for the admin API to come up.
    local i
    for i in $(seq 1 60); do
        server_up && return 0
        sleep 0.5
    done
    return 1
}

# ---------------------------------------------------------------- export

cmd_export() {
    [[ -f "$ENV_FILE" ]] || die "no ~/.fcc/.env found — nothing to export"
    local out="${1:-}"
    if [[ -z "$out" ]]; then
        out="${HOME}/fcc-backup-$(date +%Y%m%d-%H%M).tar.gz"
    fi

    TMP_DIR=$(mktemp -d)
    local tmp="$TMP_DIR"

    local count; count=$(provider_count)
    cat > "$tmp/manifest.json" <<EOF
{
  "tool": "fcc-sync",
  "fcc_version": "$(fcc_version)",
  "exported_at": "$(date -Is)",
  "hostname": "$(hostname)",
  "configured_providers": "${count}"
}
EOF

    # Build the member list: .env, existing auth token files (skip locks), manifest.
    local members=(".env")
    local f
    for f in openai.json github_copilot.json; do
        [[ -f "$AUTH_DIR/$f" ]] && members+=("auth/$f")
    done
    # Any other token json that shows up in future fcc versions.
    if [[ -d "$AUTH_DIR" ]]; then
        for f in "$AUTH_DIR"/*.json; do
            [[ -e "$f" ]] || continue
            local rel="auth/$(basename "$f")"
            # add only if not already listed
            if ! printf '%s\n' "${members[@]}" | grep -qx "$rel"; then
                members+=("$rel")
            fi
        done
    fi

    tar -czf "$out" -C "$FCC_DIR" "${members[@]}" -C "$tmp" manifest.json
    chmod 600 "$out"

    local size
    size=$(du -h "$out" | cut -f1)
    echo "Exported ${count} providers (fcc $(fcc_version)) -> $out ($size)"
    echo ""
    echo "Move it to your other device, then run:"
    echo "  scp \"$out\" <user>@<host>:"
    echo "  fcc-sync import ~/fcc-backup-*.tar.gz"
}

# ---------------------------------------------------------------- import

cmd_import() {
    local file="${1:-}"
    [[ -n "$file" ]] || die "usage: fcc-sync import <backup.tar.gz>"
    [[ -f "$file" ]] || die "file not found: $file"

    # Validate before touching anything.
    local listing
    listing=$(tar -tzf "$file" 2>/dev/null) || die "not a valid tar.gz archive: $file"
    echo "$listing" | grep -qx '.env' || die "not an fcc-sync backup (no .env inside): $file"

    echo "Importing $file"

    # 1. Back up any existing config first.
    if [[ -f "$ENV_FILE" ]]; then
        local bak="${ENV_FILE}.bak-$(date +%Y%m%d-%H%M%S)"
        cp "$ENV_FILE" "$bak"
        echo "  existing config backed up -> $bak"
    fi

    # 2. Stop the server so it doesn't race the file swap.
    if server_up; then
        echo "  stopping fcc server..."
        stop_server
    fi

    # 3. Restore files.
    mkdir -p "$FCC_DIR" "$AUTH_DIR"
    tar -xzf "$file" -C "$FCC_DIR" .env 2>/dev/null || tar -xzf "$file" -C "$FCC_DIR"
    # Extract auth tokens separately (they may or may not be in the archive).
    local m
    while IFS= read -r m; do
        case "$m" in
            auth/*.json) tar -xzf "$file" -C "$FCC_DIR" "$m" ;;
        esac
    done <<< "$listing"
    chmod 600 "$ENV_FILE" 2>/dev/null || true
    chmod 600 "$AUTH_DIR"/*.json 2>/dev/null || true
    echo "  restored .env + auth tokens"

    # 4. Install fcc if this device doesn't have it.
    if ! find_fcc_server >/dev/null; then
        echo "  fcc not installed — installing via uv..."
        local uv_bin
        if ! uv_bin=$(find_uv); then
            echo "  uv not found — installing uv first..."
            curl -LsSf https://astral.sh/uv/install.sh | sh >/dev/null
            uv_bin=$(find_uv) || die "could not install uv; install it from https://docs.astral.sh/uv/ and re-run"
        fi
        "$uv_bin" tool install free-claude-code
        # Launchers land in ~/.local/bin — make sure this shell can see them.
        export PATH="${HOME}/.local/bin:${PATH}"
    fi
    find_fcc_server >/dev/null || die "fcc-server still not available after install attempt"

    # 5. Start the server and wait for the admin API.
    echo "  starting fcc server..."
    start_server || die "server did not come up within 30s — check $LOG_FILE"

    # 6. Summarise.
    local count; count=$(provider_count)
    local model
    model=$(curl -sf --max-time 5 "$(status_url)" 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    print(d.get("model", "?"), "(", d.get("provider", "?"), ")")
except Exception:
    print("?")' 2>/dev/null || echo "?")
    echo ""
    echo "Done. ${count} providers configured, active model: ${model}"
    echo "Note: ChatGPT/Copilot logins may need re-doing if their tokens are machine-bound —"
    echo "check http://$(fcc_host):$(fcc_port)/admin if those providers show as disconnected."
}

# ---------------------------------------------------------------- status

cmd_status() {
    if ! server_up; then
        echo "fcc server: not running ($(status_url))"
        exit 0
    fi
    curl -sf "$(status_url)" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print("fcc server:  running on %s:%s" % (d.get("host", "?"), d.get("port", "?")))
print("active model: %s (%s)" % (d.get("model", "?"), d.get("provider", "?")))
provs = [p for p in d.get("provider_status", [])
         if p.get("status") not in ("missing_key", "missing_config", "disconnected")]
print("providers:    %d configured" % len(provs))
for p in provs:
    print("  - %-20s %s" % (p.get("provider_id", "?"), p.get("display_name", "")))'
}

# ---------------------------------------------------------------- main

case "${1:-help}" in
    export)  shift; cmd_export "$@" ;;
    import)  shift; cmd_import "$@" ;;
    status)  cmd_status ;;
    help|-h|--help|*)
        cat <<'EOF'
fcc-sync — move free-claude-code config between devices

usage:
  fcc-sync export [file]   export ~/.fcc/.env + OAuth tokens (default ~/fcc-backup-<date>.tar.gz)
  fcc-sync import <file>   restore a backup (backs up existing config, installs fcc if missing)
  fcc-sync status          show server state, active model, configured providers
EOF
        ;;
esac
